# Nexa Environment Variables Template
# Copy this file to .env in your root or backend directory

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Provide a MongoDB Atlas URI or local connection string:
# e.g., mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexa?retryWrites=true&w=majority
# Note: If MONGODB_URI is not provided or local MongoDB is offline, Nexa automatically falls back to its resilient in-memory dual store.
MONGODB_URI=mongodb://127.0.0.1:27017/nexa

# Authentication Security
# Generate a strong random secret key (e.g., using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=replace_with_a_long_random_string
